@startuml
title Система печати — 8 основных классов, вариант 23
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam shadowing false
skinparam classBackgroundColor #EEE9FF
skinparam classBorderColor #A78BFA
skinparam ArrowColor #64748B
skinparam classAttributeIconSize 0
hide empty members
left to right direction
class "Модель" as Simulation {
 - time: float
 - sources: List<Source>
 - admission: AdmissionDispatcher
 - selection: SelectionDispatcher
 - calendar: List<record>
 - printers: List<Printer>
 - statistics: Statistics
 + run(): void
 + step(): void
 + schedule(time: float, kind: string, ownerId: int): void
}
class "Источник" as Source {
 - id: int
 - lambda: float
 - serial: int
 + generate(t: float): PrintJob
 + nextArrival(t: float): float
}
class "Диспетчер постановки" as AdmissionDispatcher {
 - buffer: Buffer
 - statistics: Statistics
 + admit(job: PrintJob, t: float): bool
}
class "Буфер" as Buffer {
 - capacity: int
 - queue: List<PrintJob>
 + isFull(): bool
 + append(job: PrintJob): void
 + snapshot(): List<PrintJob>
 + removeById(id: string): PrintJob
}
class "Диспетчер выбора" as SelectionDispatcher {
 - buffer: Buffer
 - printers: List<Printer>
 - statistics: Statistics
 - memberIds: List<string>
 - pendingIds: List<string>
 - inFlightIds: Set<string>
 + dispatch(t: float): List<record>
 + onCompleted(job: PrintJob): void
 - formBatch(): void
 - findFreePrinter(): Printer?
}
class "Принтер" as Printer {
 - id: int
 - a, b: float
 - currentJob: PrintJob?
 - completionTime: float?
 + isFree(): bool
 + start(job: PrintJob, t: float): float
 + complete(t: float): PrintJob
}
class "Заявка" as PrintJob {
 - id: string
 - sourceId: int
 - state: string
 - arrivalTime: float
 - startedAt, completedAt: float?
 + markWaiting(): void
 + reject(): void
 + start(t: float): void
 + complete(t: float): void
}
class "Статистика" as Statistics {
 - generated, rejected, completed: Map<int,int>
 - waitingTimes, serviceTimes: Map<int,List<float>>
 - busyTimes: Map<int,float>
 + onGenerated(job: PrintJob): void
 + onRejected(job: PrintJob): void
 + onStarted(job: PrintJob): void
 + onCompleted(job: PrintJob, printerId: int): void
 + summary(T: float): table
}
Simulation *-- Source
Simulation *-- AdmissionDispatcher
Simulation *-- SelectionDispatcher
AdmissionDispatcher --> Buffer : buffer
AdmissionDispatcher --> Statistics : statistics
SelectionDispatcher --> Buffer : buffer
SelectionDispatcher --> Statistics : statistics
SelectionDispatcher --> "1..m" Printer : printers
Buffer o-- "0..N" PrintJob : queue
Printer --> "0..1" PrintJob : currentJob
Source ..> PrintJob : создаёт
note bottom of Source: ИЗ1: интервалы Exp(lambda).
note bottom of AdmissionDispatcher: Д1ОО5: отказ новой заявке, если буфер полон.
note bottom of Buffer: Д1ОЗ2: запись в конец; после извлечения — сдвиг.
note bottom of SelectionDispatcher
Д2Б5: фиксируем ID заданий одного источника.
Следующий пакет — после завершения текущего.
Д2П1: свободный принтер с минимальным номером.
end note
note bottom of Printer: ПЗ2: длительность печати U(a, b).
legend bottom
  - приватное поле или метод; + публичный метод; ? значение может отсутствовать.
  List — список; Set — множество; Map — значения по номерам источников/принтеров.
endlegend
@enduml
